DATABASE_URL=postgresql://megacorps:megacorps_dev_password@postgres:5432/megacorps
COOKIE_SECURE=false
BOOTSTRAP_TOKEN=
HERMES_GATEWAY_URL=
HERMES_DASHBOARD_TOKEN=
HERMES_SSH_HOST=
HERMES_SSH_USER=root
HERMES_SSH_PORT=22
HERMES_SSH_KEY_PATH=/home/megacorps/.ssh/id_ed25519
HERMES_SSH_COMMAND=hermes
HERMES_SSH_OPTIONS=
CODEX_APP_TRANSPORT=stdio
CODEX_APP_COMMAND=codex
CODEX_APP_ARGS=app-server
CODEX_APP_SERVER_URL=
CODEX_APP_WS_TOKEN=
CODEX_APP_MODEL=
CODEX_APP_CWD=
CODEX_APP_SANDBOX=workspace-write
CODEX_APP_EXPERIMENTAL_API=false
CODEX_APP_TIMEOUT_SECONDS=300
KANBAN_TASK_TIMEOUT_SECONDS=300
CHAT_TASK_TIMEOUT_SECONDS=300
# Gitea API from the MegaCorps server container (compose DNS). Same-host Docker: http://gitea:3000
GITEA_URL=http://gitea:3000
# Optional override for agent/runtime git clone. Defaults to GITEA_URL.
# macvlan agents cannot resolve compose DNS (gitea / megacorps-server); use the
# pinned Gitea bridge IP from docker-compose.deploy.yml (gitea=172.16.22.6).
# GITEA_INTERNAL_URL=http://172.16.22.6:3000
GITEA_INTERNAL_URL=
# Browser UI / htmlUrl / Gitea ROOT_URL only. Never injected into agent clone prompts.
# Same-host: http://localhost:3300  Cross-host: http://192.168.1.180:3300
GITEA_EXTERNAL_URL=http://localhost:3300
GITEA_ADMIN_TOKEN=
GITEA_ADMIN_USERNAME=megacorps-admin
GITEA_ADMIN_PASSWORD=megacorps_gitea_password
GITEA_HTTP_PORT=3300
GITEA_SSH_PORT=3322
PROVISIONING_SWEEP_ENABLED=true
CLIENT_CHECKPOINT_REMIND_HOURS=4
BRAINSTORM_TIMEOUT_MINUTES=30
# Agent/runtime callback base URL (webhooks, A2A push). Preferred over MEGACORPS_API_URL.
# macvlan agents cannot resolve compose DNS; use the pinned server bridge IP
# (server=172.16.22.4). Compose-internal Gitea webhooks can use the same IP.
# INTERNAL_API_URL=http://172.16.22.4:4000
INTERNAL_API_URL=
# Legacy agent callback URL. Used when INTERNAL_API_URL is unset. Adapter megacorpsApiUrl still wins.
# MEGACORPS_API_URL=http://172.16.22.4:4000
MEGACORPS_API_URL=
# Public/browser-facing API origin. Not used for agent prompts when INTERNAL_API_URL is set.
MEGACORPS_PUBLIC_URL=
ADAPTER_ENV_FALLBACK_ENABLED=false
ADAPTER_TARGET_ALLOWLIST=
WEBHOOK_ADAPTER_URL=
OPENCLAW_WEBHOOK_URL=
WEBHOOK_SHARED_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_PER_MINUTE=12
RATE_LIMIT_CHAT_PER_MINUTE=40
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_OPERATOR_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_READ_PER_MINUTE=600
TRUST_PROXY=false
CSRF_ORIGIN_CHECK=true
CSRF_TRUSTED_ORIGINS=
EXECUTION_LOCK_TTL_MS=600000
LOG_RETENTION_ENABLED=true
LOG_RETENTION_INTERVAL_MS=21600000
RETENTION_API_EVENTS_DAYS=90
RETENTION_PROMPT_LOGS_DAYS=90
RETENTION_CRON_RUNS_DAYS=90
RETENTION_ACTIVITY_LOG_DAYS=0
RETENTION_TASK_LOGS_DAYS=0
DISPATCH_LOOP_ENABLED=true
DISPATCH_LOOP_INTERVAL_MS=30000
BUDGET_RESET_ENABLED=true
BUDGET_RESET_DAY=1
TASK_RUN_WORKER_ENABLED=true
TASK_RUN_WORKER_INTERVAL_MS=2000
TASK_RUN_WORKER_BATCH_SIZE=2
TASK_RUN_WORKER_ID=megacorps-server
DISPATCH_CONTEXT_CHAR_BUDGET=32000
DISPATCH_CONTEXT_CARD_LIMIT=160
DISPATCH_CONTEXT_RECORD_LIMIT=30
DISPATCH_TASK_BODY_CHAR_LIMIT=12000
DISPATCH_KNOWLEDGE_DOC_CHAR_LIMIT=4000
MESSAGE_BOARD_COMMENT_LIMIT=20000
# Browser fallback API URL baked into the web client. Not used for agent callbacks.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web container -> API container. Same-host Docker: http://server:4000
SERVER_API_URL=http://server:4000
